# ============================================================================
# TRINITY environment file. Copy to .env and fill in. NEVER commit .env.
# Secrets live ONLY here (or in OS environment variables), never in YAML or the DB.
# Never put seed phrases or wallet private keys anywhere: TRINITY never needs them.
# ============================================================================

# ---- Mode (safe defaults) ---------------------------------------------------
PAPER_TRADING=true
LIVE_TRADING=false
# To ever allow live trading this must equal EXACTLY:
# I UNDERSTAND THAT LIVE TRADING CAN LOSE REAL MONEY
LIVE_TRADING_ACKNOWLEDGEMENT=

# ---- Limited leverage (TRINITY 3.0) -----------------------------------------
# OFF by default and never used in the initial phase of real trading.
# Even with these set, leverage requires >= 60 days of successful live trading WITHOUT
# leverage, leverage.enabled=true in strategies.yaml, passing tests and a local approval
# (python trinity/scripts/leverage.py --approve). Isolated margin, BTC/ETH only, max 1.5x (hard cap 2x).
LIVE_LEVERAGE_ENABLED=false
# Must equal EXACTLY: I UNDERSTAND THAT LEVERAGE CAN LIQUIDATE MY POSITION
LEVERAGE_ACKNOWLEDGEMENT=
# CCXT id of the derivatives (USDT-margined perpetuals) venue; empty = CRYPTO_EXCHANGE_ID
CRYPTO_PERP_EXCHANGE_ID=

# ---- Storage / logging ------------------------------------------------------
# DATABASE_PATH=data/trinity.db
# BACKUP_DIR=data/backups
# LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Telegram control center ------------------------------------------------
# Create a bot with @BotFather, then get your numeric user id (e.g. @userinfobot).
TELEGRAM_BOT_TOKEN=
# Comma separated numeric user ids. Telegram is DISABLED if this is empty.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Crypto exchange (Crypto Grid) ------------------------------------------
# Any CCXT exchange id available in YOUR jurisdiction (e.g. binance, kraken, okx, bybit).
CRYPTO_EXCHANGE_ID=binance
# API key with TRADE permission only. DISABLE withdrawals. Restrict to your IP if possible.
# Not needed for paper trading (public market data is used).
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# Some exchanges (OKX, KuCoin) also need a passphrase:
CRYPTO_API_PASSWORD=

# ---- Arbitrage scanner (public market data only, never trades) -------------
ARB_EXCHANGE_IDS=binance,kraken,okx

# ---- Stock broker (Stock Trend) ---------------------------------------------
STOCK_BROKER=alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# true = Alpaca's own paper environment (paper-api.alpaca.markets). Must be false for live.
ALPACA_PAPER_ACCOUNT=true
ALPACA_DATA_FEED=iex
# alpaca | csv | none   (csv reads data/csv/<SYMBOL>.csv)
STOCK_DATA_PROVIDER=alpaca

# ---- Currency ---------------------------------------------------------------
# Internal settlement currency is USD. If your broker account is in EUR set:
ACCOUNT_CURRENCY=USD
# EUR_USD_RATE=1.08

DASHBOARD_PORT=8501

# ---- Google Sheets trading journal (optional) -------------------------------
# SQLite stays the primary database; Sheets is a secondary journal. See GOOGLE_SHEETS_SETUP.md.
GOOGLE_SHEETS_ENABLED=false
# ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# Empty = TRINITY creates "TRINITY 3.0 — Trading Journal" itself (works with OAuth; service accounts
# usually cannot own files - create the sheet yourself and share it with the service account).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Option A: service account key (JSON). Keep it OUTSIDE the repository or in trinity/secrets/ (git-ignored).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: OAuth 2.0 (desktop client). Run: python trinity/scripts/sheets.py --oauth-setup
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_SHEETS_TIMEZONE=Europe/Amsterdam
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=60
