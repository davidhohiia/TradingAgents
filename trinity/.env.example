# ============================================================================
# TRINITY environment file. Copy to .env and fill in. NEVER commit .env.
# Secrets live ONLY here (or in OS environment variables), never in YAML or the DB.
# Never put seed phrases or wallet private keys anywhere: TRINITY never needs them.
# ============================================================================

# ---- Mode (safe defaults) ---------------------------------------------------
PAPER_TRADING=true
LIVE_TRADING=false
# To ever allow live trading this must equal EXACTLY:
# I UNDERSTAND THAT LIVE TRADING CAN LOSE REAL MONEY
LIVE_TRADING_ACKNOWLEDGEMENT=

# ---- Storage / logging ------------------------------------------------------
# DATABASE_PATH=data/trinity.db
# BACKUP_DIR=data/backups
# LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Telegram control center ------------------------------------------------
# Create a bot with @BotFather, then get your numeric user id (e.g. @userinfobot).
TELEGRAM_BOT_TOKEN=
# Comma separated numeric user ids. Telegram is DISABLED if this is empty.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Crypto exchange (Crypto Grid) ------------------------------------------
# Any CCXT exchange id available in YOUR jurisdiction (e.g. binance, kraken, okx, bybit).
CRYPTO_EXCHANGE_ID=binance
# API key with TRADE permission only. DISABLE withdrawals. Restrict to your IP if possible.
# Not needed for paper trading (public market data is used).
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# Some exchanges (OKX, KuCoin) also need a passphrase:
CRYPTO_API_PASSWORD=

# ---- Arbitrage scanner (public market data only, never trades) -------------
ARB_EXCHANGE_IDS=binance,kraken,okx

# ---- Stock broker (Stock Trend) ---------------------------------------------
STOCK_BROKER=alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# true = Alpaca's own paper environment (paper-api.alpaca.markets). Must be false for live.
ALPACA_PAPER_ACCOUNT=true
ALPACA_DATA_FEED=iex
# alpaca | csv | none   (csv reads data/csv/<SYMBOL>.csv)
STOCK_DATA_PROVIDER=alpaca

# ---- Currency ---------------------------------------------------------------
# Internal settlement currency is USD. If your broker account is in EUR set:
ACCOUNT_CURRENCY=USD
# EUR_USD_RATE=1.08

DASHBOARD_PORT=8501
